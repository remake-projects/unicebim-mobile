# Supabase project (Dashboard → Project Settings → API). Both values are public; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public privacy policy and terms of use pages (docs/release/). Required for store builds.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
